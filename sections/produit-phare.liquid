{%- comment -%}Produit phare : bloc sombre avec texte, lignes de prix reliées aux produits, boutons et photo.{%- endcomment -%}

<div {% render 'section-properties' %}>
  <div class="cl-phare" style="--background: {{ section.settings.card_background.rgb | default: settings.text_color.rgb }}; --text-color: {{ section.settings.card_text_color.rgb | default: settings.background.rgb }};">
    <div class="cl-phare__text v-stack gap-5">
      {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="h1">{{ section.settings.title | escape }}</h2>{%- endif -%}
      {%- if section.settings.content != blank -%}<div class="prose cl-phare__lead">{{ section.settings.content }}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="cl-rows">
          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              assign filter = block.settings.filter | strip | downcase
              assign min = nil
              if product != blank
                if filter == blank
                  assign min = product.price_min
                else
                  for v in product.variants
                    assign vt = v.title | downcase
                    if vt contains filter
                      if min == nil or v.price < min
                        assign min = v.price
                      endif
                    endif
                  endfor
                endif
              endif
            -%}
            <a class="cl-row" href="{{ product.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
              <span class="cl-row__label"><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %}<small>{{ block.settings.text | escape }}</small>{% endif %}</span>
              {%- if block.settings.price_text != blank -%}
                <span class="cl-row__note">{{ block.settings.price_text | escape }}</span>
              {%- elsif min != nil -%}
                <span class="cl-row__price"><small>dès</small> {{ min | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="cl-hero__buttons">
        {%- if section.settings.button_text != blank -%}
          {%- render 'button', content: section.settings.button_text, href: section.settings.button_link -%}
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
          {%- render 'button', content: section.settings.button2_text, href: section.settings.button2_link, style: 'outline', background: section.settings.card_text_color, text_color: section.settings.card_text_color -%}
        {%- endif -%}
      </div>
      {%- if section.settings.note != blank -%}<p class="cl-phare__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>

    <div class="cl-phare__media">
      {%- if section.settings.image != blank -%}
        {{- section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(max-width: 999px) 100vw, 50vw', widths: '500,800,1100,1600' -}}
      {%- else -%}
        {{- 'lifestyle-2' | placeholder_svg_tag: 'placeholder' -}}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Produit phare",
  "class": "shopify-section--flagship",
  "tag": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": true },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Produit phare" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Votre parking devient une centrale." },
    { "type": "richtext", "id": "content", "label": "Texte" },
    { "type": "text", "id": "button_text", "label": "Bouton principal" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "button2_text", "label": "Second bouton" },
    { "type": "url", "id": "button2_link", "label": "Lien du second bouton" },
    { "type": "text", "id": "note", "label": "Petite ligne sous les boutons" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "card_background", "label": "Fond du bloc", "default": "#16181d" },
    { "type": "color", "id": "card_text_color", "label": "Texte du bloc", "default": "#ffffff" },
    { "type": "color", "id": "background", "label": "Arrière-plan de la section", "default": "rgba(0,0,0,0)" },
    { "type": "color_background", "id": "background_gradient", "label": "Dégradé d'arrière-plan" },
    { "type": "color", "id": "text_color", "label": "Texte de la section", "default": "rgba(0,0,0,0)" }
  ],
  "blocks": [
    {
      "type": "ligne",
      "name": "Ligne de prix",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "filter", "label": "Limiter aux variantes contenant", "info": "Exemple : « 1 voiture ». Vide : toutes les variantes." },
        { "type": "text", "id": "title", "label": "Titre", "default": "Carport métal · 1 voiture" },
        { "type": "text", "id": "text", "label": "Précision" },
        { "type": "text", "id": "price_text", "label": "Texte à la place du prix", "info": "Vide : « dès » suivi du prix le plus bas." },
        { "type": "url", "id": "link", "label": "Lien (si aucun produit)" }
      ]
    }
  ],
  "presets": [ { "name": "Produit phare", "blocks": [ { "type": "ligne" }, { "type": "ligne" } ] } ]
}
{% endschema %}
