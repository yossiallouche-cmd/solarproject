{%- comment -%}
  CLARTÉ — Entrée par besoin
  Cartes « verbe » (M'abriter et produire, Produire, Stocker, Chauffer, Rafraîchir…) avec prix « à partir de »
  lu sur une collection (prix mini) ou un produit, ou saisi à la main.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #shopify-section-{{ section.id }} .cl-needs { background: {{ s.background | default: '#F6F4EE' }}; color: {{ s.text_color | default: '#0E1A2B' }}; }
</style>

<section class="cl-needs cl-section" aria-labelledby="cl-needs-{{ section.id }}">
  <div class="cl-container">
    <div class="cl-head cl-head--split">
      <div>
        {%- if s.eyebrow != blank -%}<p class="cl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="cl-needs-{{ section.id }}" class="cl-h2">{{ s.title | remove: '<p>' | remove: '</p>' }}</h2>
      </div>
      {%- if s.text != blank -%}<div class="cl-lead">{{ s.text }}</div>{%- endif -%}
    </div>

    <div class="cl-needs__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign price = nil
          assign url = b.url

          if b.collection != blank
            assign cheapest = b.collection.products | sort: 'price_min' | first
            if cheapest
              assign price = cheapest.price_min
            endif
            if url == blank
              assign url = b.collection.url
            endif
          endif

          if b.product != blank
            assign price = b.product.price_min
            if url == blank
              assign url = b.product.url
            endif
          endif

          if b.manual_price != blank and b.manual_price > 0
            assign price = b.manual_price | times: 100
          endif
        -%}
        <a class="cl-need {% if b.accent %}cl-need--accent{% endif %}" href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="cl-need__icon">
            {%- if b.custom_icon != blank -%}
              {{ b.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'clarte-icon', icon: b.icon -%}
            {%- endif -%}
          </span>
          <span class="cl-need__body">
            {%- if b.kicker != blank -%}<span class="cl-need__kicker">{{ b.kicker | escape }}</span>{%- endif -%}
            <span class="cl-need__title">{{ b.title | escape }}</span>
            {%- if b.text != blank -%}<span class="cl-need__text">{{ b.text | escape }}</span>{%- endif -%}
          </span>
          <span class="cl-need__foot">
            <span class="cl-need__price">
              {%- if price -%}
                <small>{{ s.price_prefix | escape }}</small>
                <strong>{{ price | money_without_trailing_zeros }}</strong>
              {%- else -%}
                <strong>{{ b.price_fallback | escape }}</strong>
              {%- endif -%}
            </span>
            <span class="cl-need__arrow">{%- render 'clarte-icon', icon: 'arrow' -%}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clarté · Besoins",
  "tag": "section",
  "class": "shopify-section--clarte-needs",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Par où commencer ?" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Dites-nous ce que vous voulez faire, <em>on vous dit combien ça coûte.</em></p>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Chaque prix affiché comprend la fourniture, la pose et la mise en service. Vous configurez, vous voyez le total, vous commandez.</p>" },
    { "type": "text", "id": "price_prefix", "label": "Préfixe des prix", "default": "à partir de" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F6F4EE" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#0E1A2B" }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Besoin",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "carport", "label": "Carport" }, { "value": "sun", "label": "Soleil" }, { "value": "battery", "label": "Batterie" },
          { "value": "flame", "label": "Flamme (chauffage)" }, { "value": "snow", "label": "Flocon (clim)" }, { "value": "umbrella", "label": "Pergola / abri" },
          { "value": "home", "label": "Maison" }, { "value": "bolt", "label": "Éclair" }, { "value": "car", "label": "Voiture" } ], "default": "sun" },
        { "type": "image_picker", "id": "custom_icon", "label": "Icône personnalisée (optionnel)" },
        { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Je veux" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Produire mon électricité" },
        { "type": "text", "id": "text", "label": "Description", "default": "Kits solaires 6 à 18 panneaux, posés en toiture." },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Le prix « à partir de » est le prix le plus bas de la collection." },
        { "type": "product", "id": "product", "label": "Ou produit" },
        { "type": "number", "id": "manual_price", "label": "Ou prix saisi (€)" },
        { "type": "text", "id": "price_fallback", "label": "Texte si aucun prix", "default": "Voir les prix" },
        { "type": "url", "id": "url", "label": "Lien (optionnel)" },
        { "type": "checkbox", "id": "accent", "label": "Carte mise en avant (fond sombre)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarté · Besoins",
      "category": "Clarté",
      "blocks": [
        { "type": "need", "settings": { "icon": "carport", "kicker": "Je veux", "title": "M'abriter et produire", "text": "Carport solaire métal ou bois, 1 ou 2 voitures.", "manual_price": 5999, "accent": true } },
        { "type": "need", "settings": { "icon": "sun", "kicker": "Je veux", "title": "Produire", "text": "Kits solaires 6 à 18 panneaux, posés en toiture.", "manual_price": 3300 } },
        { "type": "need", "settings": { "icon": "battery", "kicker": "Je veux", "title": "Stocker", "text": "Batteries 5 à 20 kWh, seules ou avec panneaux.", "manual_price": 1650 } },
        { "type": "need", "settings": { "icon": "flame", "kicker": "Je veux", "title": "Chauffer", "text": "Pompes à chaleur air/eau, posées et mises en service.", "manual_price": 6050 } },
        { "type": "need", "settings": { "icon": "snow", "kicker": "Je veux", "title": "Rafraîchir", "text": "Climatisation réversible mono ou multi-split.", "manual_price": 1440 } }
      ]
    }
  ]
}
{% endschema %}
