{%- comment -%}
  CLARTÉ — Garanties (bande sombre, cartes icône + titre + texte)
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #shopify-section-{{ section.id }} .cl-guarsec { background: {{ s.background | default: '#0E1A2B' }}; color: {{ s.text_color | default: '#F6F4EE' }}; }
</style>

<section class="cl-guarsec cl-section cl-ink{% unless settings.clarte_heading_italic_accent %} cl-accent-color{% endunless %}" aria-labelledby="cl-guar-{{ section.id }}">
  <div class="cl-container">
    <div class="cl-head cl-head--split">
      <div>
        {%- if s.eyebrow != blank -%}<p class="cl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="cl-guar-{{ section.id }}" class="cl-h2">{{ s.title | remove: '<p>' | remove: '</p>' }}</h2>
      </div>
      {%- if s.text != blank -%}<div class="cl-lead">{{ s.text }}</div>{%- endif -%}
    </div>

    <div class="cl-guar__grid">
      {%- for block in section.blocks -%}
        <div class="cl-guar" {{ block.shopify_attributes }}>
          <span class="cl-guar__icon">{%- render 'clarte-icon', icon: block.settings.icon -%}</span>
          <h3 class="cl-guar__title">{{ block.settings.title | escape }}</h3>
          <div class="cl-guar__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clarté · Garanties",
  "tag": "section",
  "class": "shopify-section--clarte-guarantees",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Vous êtes couvert" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Des garanties écrites, <em>pas des promesses.</em></p>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous sommes votre interlocuteur unique, de la commande au service après-vente. Nos installateurs sont certifiés et assurés, et nous le sommes aussi.</p>" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#0E1A2B" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#F6F4EE" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantie",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "shield", "label": "Bouclier" }, { "value": "document", "label": "Document" }, { "value": "tool", "label": "Outils" },
          { "value": "star", "label": "Étoile" }, { "value": "lock", "label": "Cadenas" }, { "value": "check", "label": "Coche" },
          { "value": "phone", "label": "Téléphone" }, { "value": "euro", "label": "Euro" }, { "value": "leaf", "label": "Feuille" } ], "default": "shield" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Garantie décennale" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>L'installation est couverte 10 ans par notre assurance décennale, en plus des garanties fabricants.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarté · Garanties",
      "category": "Clarté",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "title": "Garantie décennale", "text": "<p>L'installation est couverte 10 ans par notre assurance décennale, en plus des garanties fabricants (25 ans sur les panneaux).</p>" } },
        { "type": "item", "settings": { "icon": "tool", "title": "Installateurs certifiés RGE", "text": "<p>Chaque chantier est réalisé par une équipe certifiée RGE QualiPV / QualiPAC, sélectionnée et suivie par nous.</p>" } },
        { "type": "item", "settings": { "icon": "euro", "title": "Prix ferme, solde après pose", "text": "<p>30 % à la commande, le reste une fois l'installation mise en service. Aucun supplément le jour J.</p>" } },
        { "type": "item", "settings": { "icon": "phone", "title": "Un seul interlocuteur", "text": "<p>Avant, pendant et après : la même équipe répond, au téléphone comme par e-mail, pendant toute la vie de l'installation.</p>" } }
      ]
    }
  ]
}
{% endschema %}
