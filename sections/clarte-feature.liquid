{%- comment -%}
  CLARTÉ — Produit phare (carport solaire)
  Bande sombre : sur-titre, titre, texte, image avec badge, liste d'options (blocs « option ») avec prix,
  faits clés (blocs « fait ») et bouton.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #shopify-section-{{ section.id }} .cl-feature { background: {{ s.background | default: '#0E1A2B' }}; color: {{ s.text_color | default: '#F6F4EE' }}; }
</style>

<section class="cl-feature cl-section cl-ink" aria-labelledby="cl-feature-{{ section.id }}">
  <div class="cl-container">
    <div class="cl-feature__grid">
      <div class="cl-feature__media">
        <div class="cl-media" style="position:relative">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
          {%- else -%}
            <div class="cl-media--placeholder" style="aspect-ratio:4/3">{%- render 'clarte-icon', icon: 'carport' -%}</div>
          {%- endif -%}
          {%- if s.badge != blank -%}<span class="cl-feature__badge">{{ s.badge | escape }}</span>{%- endif -%}
        </div>
      </div>

      <div class="cl-feature__copy">
        {%- if s.eyebrow != blank -%}<p class="cl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="cl-feature-{{ section.id }}" class="cl-h2">{{ s.title | remove: '<p>' | remove: '</p>' }}</h2>
        {%- if s.text != blank -%}<div class="cl-lead">{{ s.text }}</div>{%- endif -%}

        {%- assign options = section.blocks | where: 'type', 'option' -%}
        {%- if options.size > 0 -%}
          <div class="cl-feature__options">
            {%- for block in options -%}
              {%- liquid
                assign b = block.settings
                assign price_text = b.price_text
                if b.product != blank and price_text == blank
                  assign price_text = b.product.price_min | money_without_trailing_zeros
                endif
                assign url = b.url
                if url == blank and b.product != blank
                  assign url = b.product.url
                endif
              -%}
              <a class="cl-option" href="{{ url | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="cl-option__title">{{ b.title | escape }}</span>
                <span class="cl-option__price">{%- if b.price_prefix != blank -%}<small>{{ b.price_prefix | escape }}</small>{%- endif -%}{{ price_text | escape }}</span>
                <span class="cl-option__desc">{{ b.text | escape }}</span>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign facts = section.blocks | where: 'type', 'fact' -%}
        {%- if facts.size > 0 -%}
          <ul class="cl-feature__facts" role="list">
            {%- for block in facts -%}
              <li class="cl-chip" {{ block.shopify_attributes }}>{%- render 'clarte-icon', icon: 'check' -%}{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.button_text != blank -%}
          <div class="cl-actions">
            <a href="{{ s.button_url }}" class="button button--xl cl-btn-amber">{{ s.button_text | escape }}</a>
            {%- if s.link_text != blank -%}
              <a href="{{ s.link_url }}" class="cl-link">{{ s.link_text | escape }}{%- render 'clarte-icon', icon: 'arrow' -%}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clarté · Produit phare",
  "tag": "section",
  "class": "shopify-section--clarte-feature",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Produit phare" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Le carport solaire : abritez votre voiture, <em>produisez votre électricité.</em></p>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Structure métal pour 1 ou 2 voitures, ou bois sur mesure. Posé sur plots béton, sans fondation lourde, avec déclaration préalable en mairie fournie. Prix affiché, pose incluse.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge sur l'image", "default": "À partir de 5 999 € posé" },
    { "type": "text", "id": "button_text", "label": "Bouton", "default": "Configurer mon carport" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" },
    { "type": "text", "id": "link_text", "label": "Lien secondaire", "default": "Voir tous les carports" },
    { "type": "url", "id": "link_url", "label": "URL du lien secondaire" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#0E1A2B" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#F6F4EE" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option (modèle)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Carport métal 1 voiture" },
        { "type": "text", "id": "text", "label": "Description", "default": "3 × 5 m · 6 panneaux · 2,7 kWc" },
        { "type": "product", "id": "product", "label": "Produit lié", "info": "Prix et lien repris automatiquement s'ils ne sont pas saisis." },
        { "type": "text", "id": "price_prefix", "label": "Préfixe prix", "default": "dès" },
        { "type": "text", "id": "price_text", "label": "Prix affiché", "default": "5 999 €" },
        { "type": "url", "id": "url", "label": "Lien" }
      ]
    },
    {
      "type": "fact",
      "name": "Fait clé",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Plots béton, sans fondation" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarté · Produit phare",
      "category": "Clarté",
      "blocks": [
        { "type": "option", "settings": { "title": "Carport métal 1 voiture", "text": "3 × 5 m · 6 panneaux · 2,7 kWc", "price_prefix": "dès", "price_text": "5 999 €" } },
        { "type": "option", "settings": { "title": "Carport métal 2 voitures", "text": "6 × 5 m · 12 panneaux · 5,4 kWc", "price_prefix": "", "price_text": "Prix dans le configurateur" } },
        { "type": "option", "settings": { "title": "Carport bois sur mesure", "text": "Dimensions libres, prix instantané", "price_prefix": "", "price_text": "Sur mesure" } },
        { "type": "fact", "settings": { "text": "Plots béton, sans fondation" } },
        { "type": "fact", "settings": { "text": "Déclaration mairie fournie" } },
        { "type": "fact", "settings": { "text": "Borne de recharge en option" } }
      ]
    }
  ]
}
{% endschema %}
