{%- comment -%}
  Conseil climatisation hors fiche produit : nombre de pièces puis surface, les questions s'enchaînent seules.
  Le résultat donne la configuration conseillée, son prix posé et un lien vers elle.
{%- endcomment -%}

{%- assign product = section.settings.product -%}
{%- if product != blank -%}
  <div {% render 'section-properties' %}>
    <div class="cl-climfinder" id="conseil-clim">
      <div class="prose">
        {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="h1">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {{- section.settings.content -}}
        {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
          <p>{%- render 'button', content: section.settings.link_text, href: section.settings.link_url, style: 'outline', background: settings.text_color, text_color: settings.text_color -%}</p>
        {%- endif -%}
      </div>

      <clarte-clim-advisor
        id="clim-finder-{{ section.id }}"
        class="cl-advisor cl-advisor--large"
        data-watts-per-m2="{{ section.settings.watts_per_m2 }}"
        data-surfaces="{{ section.settings.surfaces | escape }}"
        data-q-rooms="{{ section.settings.q_rooms | escape }}"
        data-q-surface="{{ section.settings.q_surface | escape }}"
        data-more-text="{{ section.settings.more_text | escape }}"
        data-note="{{ section.settings.note | escape }}"
        data-product-url="{{ product.url }}"
        data-price-label="{{ section.settings.price_label | escape }}"
        data-button-text="{{ section.settings.button_text | escape }}"
      >
        <script type="application/json" data-product>
          {
            "options": [
              {%- for option in product.options_with_values -%}
                { "name": {{ option.name | json }}, "values": {{ option.values | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ],
            "variants": [
              {%- for v in product.variants -%}
                { "id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>
        <div class="cl-advisor__steps" data-steps></div>
        <div class="cl-advisor__result" data-result aria-live="polite" hidden></div>
      </clarte-clim-advisor>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Conseil climatisation",
  "class": "shopify-section--clim-finder",
  "tag": "section",
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": true },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Climatisation" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Quelle clim pour votre logement ?" },
    { "type": "richtext", "id": "content", "label": "Texte" },
    { "type": "text", "id": "link_text", "label": "Texte du bouton" },
    { "type": "url", "id": "link_url", "label": "Lien du bouton" },
    { "type": "header", "content": "Conseil" },
    { "type": "product", "id": "product", "label": "Climatisation proposée", "info": "Ses options (nombre de pièces, puissance) et ses prix servent au conseil." },
    { "type": "text", "id": "q_rooms", "label": "Question 1", "default": "Combien de pièces à climatiser ?" },
    { "type": "text", "id": "q_surface", "label": "Question 2", "default": "Surface de la plus grande pièce ?" },
    { "type": "range", "id": "watts_per_m2", "label": "Puissance nécessaire par m²", "min": 60, "max": 160, "step": 10, "unit": "W", "default": 100 },
    { "type": "text", "id": "surfaces", "label": "Paliers de surface (m²)", "default": "20, 25, 35, 50, 70" },
    { "type": "text", "id": "price_label", "label": "Libellé du prix", "default": "Total posé" },
    { "type": "text", "id": "button_text", "label": "Bouton du résultat", "default": "Voir cette climatisation" },
    { "type": "richtext", "id": "note", "label": "Note sous le résultat", "default": "<p>Conseil indicatif, confirmé par le technicien lors de l'appel offert.</p>" },
    { "type": "text", "id": "more_text", "label": "Message au-delà du nombre de pièces proposé", "default": "Au-delà, nous étudions votre projet par téléphone." },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Arrière-plan", "default": "rgba(0,0,0,0)" },
    { "type": "color_background", "id": "background_gradient", "label": "Dégradé d'arrière-plan" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "rgba(0,0,0,0)" }
  ],
  "presets": [ { "name": "Conseil climatisation" } ]
}
{% endschema %}
