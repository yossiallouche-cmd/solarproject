{%- comment -%}
  Accroches d'accueil : texte et boutons à gauche, photo à droite avec la carte « prix posé » d'un produit.
  Une accroche par bloc ; à partir de deux, elles défilent.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <div {% render 'section-properties' %}>
    <clarte-hero class="cl-hero-carousel" {% if section.settings.autoplay %}data-autoplay{% endif %} data-speed="{{ section.settings.speed }}">
      <div class="cl-hero-slides">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="cl-hero {% if forloop.first %}is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
            <div class="cl-hero__text v-stack gap-6">
              {%- if b.subheading != blank -%}<p class="subheading">{{ b.subheading | escape }}</p>{%- endif -%}
              {%- if forloop.first -%}<h1 class="h0">{%- else -%}<h2 class="h0">{%- endif -%}
                {{- b.title | escape | newline_to_br -}}
                {%- if b.title_accent != blank -%}<br><span class="cl-hero__accent">{{ b.title_accent | escape }}</span>{%- endif -%}
              {%- if forloop.first -%}</h1>{%- else -%}</h2>{%- endif -%}
              {%- if b.content != blank -%}<div class="prose cl-hero__lead">{{ b.content }}</div>{%- endif -%}

              <div class="cl-hero__buttons">
                {%- if b.button_text != blank -%}
                  {%- render 'button', content: b.button_text, href: b.button_link, size: 'xl' -%}
                {%- endif -%}
                {%- if b.button2_text != blank -%}
                  {%- render 'button', content: b.button2_text, href: b.button2_link, size: 'xl', style: 'outline', background: settings.text_color, text_color: settings.text_color -%}
                {%- endif -%}
              </div>

              {%- if b.checks != blank -%}
                <ul class="cl-hero__checks" role="list">
                  {%- assign checks = b.checks | newline_to_br | split: '<br />' -%}
                  {%- for check in checks -%}
                    {%- assign check_text = check | strip -%}
                    {%- if check_text != blank -%}
                      <li><svg aria-hidden="true" focusable="false" fill="none" viewBox="0 0 24 24" width="16" height="16"><path d="m5 12 5 5L20 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ check_text | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

            <div class="cl-hero__visual">
              <div class="cl-hero__media">
                {%- if b.image != blank -%}
                  {%- if forloop.first -%}
                    {{- b.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 999px) 100vw, 50vw', widths: '500,800,1100,1600' -}}
                  {%- else -%}
                    {{- b.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(max-width: 999px) 100vw, 50vw', widths: '500,800,1100,1600' -}}
                  {%- endif -%}
                {%- else -%}
                  {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder' -}}
                {%- endif -%}
              </div>
              {%- if b.product != blank -%}
                <a class="cl-hero__card" href="{{ b.product.url }}" aria-label="{{ b.product.title | escape }}">
                  {%- render 'clarte-price-card', product: b.product, title: b.card_title -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="cl-hero-nav">
          <button type="button" class="cl-hero-nav__arrow" data-prev aria-label="Accroche précédente">{%- render 'icon' with 'chevron-left' -%}</button>
          <div class="cl-hero-nav__dots">
            {%- for block in section.blocks -%}
              <button type="button" data-dot aria-label="{{ block.settings.title | newline_to_br | replace: '<br />', ' ' | escape }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
            {%- endfor -%}
          </div>
          <button type="button" class="cl-hero-nav__arrow" data-next aria-label="Accroche suivante">{%- render 'icon' with 'chevron-right' -%}</button>
        </div>
      {%- endif -%}
    </clarte-hero>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Accueil : accroche",
  "class": "shopify-section--home-hero",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Pleine largeur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Défilement automatique",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durée de chaque accroche",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Arrière-plan",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Dégradé d'arrière-plan"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Accueil : accroche",
      "blocks": [
        {
          "type": "accroche"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "accroche",
      "name": "Accroche",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Sous-titre"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Titre",
          "default": "Votre énergie,\nau prix affiché."
        },
        {
          "type": "text",
          "id": "title_accent",
          "label": "Dernière ligne du titre, en couleur",
          "default": "Pose incluse."
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Texte"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Bouton principal",
          "default": "Voir les prix posés"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton principal"
        },
        {
          "type": "text",
          "id": "button2_text",
          "label": "Second bouton"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Lien du second bouton"
        },
        {
          "type": "textarea",
          "id": "checks",
          "label": "Arguments cochés",
          "info": "Un par ligne."
        },
        {
          "type": "header",
          "content": "Visuel"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit de la carte de prix",
          "info": "La carte affiche fourniture, pose et total de la première variante."
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Titre de la carte"
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
