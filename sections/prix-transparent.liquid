{%- comment -%}Prix transparent : promesse et chiffres à gauche, comparaison « ailleurs » / « ici » à droite avec la carte de prix d'un produit.{%- endcomment -%}

<div {% render 'section-properties' %}>
  <div class="cl-transp">
    <div class="v-stack gap-6">
      {%- if section.settings.subheading != blank -%}<p class="subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="h1">{{ section.settings.title | escape }}</h2>{%- endif -%}
      {%- if section.settings.content != blank -%}<div class="prose cl-transp__lead">{{ section.settings.content }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="cl-transp__figures">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <p class="h2">{{ block.settings.figure | escape }}</p>
              <p class="cl-transp__figure-label">{{ block.settings.label | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="cl-transp__compare">
      <div class="cl-transp__other">
        <p class="subheading">{{ section.settings.other_label | escape }}</p>
        <span class="cl-transp__bar" style="width: 70%"></span>
        <span class="cl-transp__bar" style="width: 55%"></span>
        <span class="cl-transp__bar" style="width: 62%"></span>
        <span class="cl-transp__bar" style="width: 40%"></span>
        {%- if section.settings.other_text != blank -%}<p>{{ section.settings.other_text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.product != blank -%}
        <a class="cl-transp__here" href="{{ section.settings.product.url }}">
          <span class="cl-transp__here-label">{{ section.settings.here_label | escape }}</span>
          {%- render 'clarte-price-card', product: section.settings.product, title: section.settings.card_title, note: section.settings.card_note -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Prix transparent",
  "class": "shopify-section--transparent-price",
  "tag": "section",
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": true },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "Notre différence" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le prix que vous voyez est le prix que vous payez." },
    { "type": "richtext", "id": "content", "label": "Texte" },
    { "type": "header", "content": "Comparaison" },
    { "type": "text", "id": "other_label", "label": "Libellé de gauche", "default": "Ailleurs" },
    { "type": "text", "id": "other_text", "label": "Texte de gauche", "default": "Un rendez-vous, une visite, puis un devis. Le prix arrive à la fin." },
    { "type": "text", "id": "here_label", "label": "Libellé de droite", "default": "Ici" },
    { "type": "product", "id": "product", "label": "Produit de la carte de prix" },
    { "type": "text", "id": "card_title", "label": "Titre de la carte" },
    { "type": "text", "id": "card_note", "label": "Petite ligne sous le total", "default": "Prix visible avant de commander. Devis écrit sur demande." },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Arrière-plan", "default": "#16181d" },
    { "type": "color_background", "id": "background_gradient", "label": "Dégradé d'arrière-plan" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "chiffre", "name": "Chiffre", "settings": [
      { "type": "text", "id": "figure", "label": "Chiffre", "default": "48 h" },
      { "type": "text", "id": "label", "label": "Légende", "default": "pour l'appel technique" }
    ] }
  ],
  "presets": [ { "name": "Prix transparent", "blocks": [ { "type": "chiffre" }, { "type": "chiffre" }, { "type": "chiffre" } ] } ]
}
{% endschema %}
