{%- comment -%}
  CLARTÉ — Projection d'économies (mini-simulateur)
  Le visiteur règle sa facture mensuelle ; on affiche l'économie annuelle, sur 20 ans et le temps de retour,
  à partir d'un taux d'économie et d'un prix de référence réglables dans l'éditeur.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #shopify-section-{{ section.id }} .cl-proj { background: {{ s.background | default: '#FFFFFF' }}; color: {{ s.text_color | default: '#0E1A2B' }}; }
</style>

<section class="cl-proj cl-section{% unless settings.clarte_heading_italic_accent %} cl-accent-color{% endunless %}" aria-labelledby="cl-proj-{{ section.id }}">
  <div class="cl-container">
    <div class="cl-proj__grid">
      <div class="cl-feature__copy">
        {%- if s.eyebrow != blank -%}<p class="cl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="cl-proj-{{ section.id }}" class="cl-h2">{{ s.title | remove: '<p>' | remove: '</p>' }}</h2>
        {%- if s.text != blank -%}<div class="cl-lead">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_text != blank -%}
          <div class="cl-actions">{%- render 'button', content: s.button_text, href: s.button_url, size: 'lg' -%}</div>
        {%- endif -%}
      </div>

      <clarte-projection
        class="cl-proj__panel"
        data-rate="{{ s.saving_rate | divided_by: 100.0 }}"
        data-inflation="{{ s.inflation | divided_by: 100.0 }}"
        data-price="{{ s.reference_price }}"
        data-years="{{ s.years }}"
      >
        <div class="cl-range">
          <div class="cl-range__head">
            <label for="cl-proj-bill-{{ section.id }}">{{ s.bill_label | escape }}</label>
            <output for="cl-proj-bill-{{ section.id }}" data-out="bill">{{ s.bill_default }} €</output>
          </div>
          <input id="cl-proj-bill-{{ section.id }}" type="range" min="{{ s.bill_min }}" max="{{ s.bill_max }}" step="10" value="{{ s.bill_default }}" data-input="bill">
          <div class="cl-range__scale"><span>{{ s.bill_min }} €</span><span>{{ s.bill_max }} €</span></div>
        </div>

        <div class="cl-proj__results">
          <div class="cl-proj__kpi cl-proj__kpi--green"><small>{{ s.kpi_year_label | escape }}</small><strong data-out="year">—</strong></div>
          <div class="cl-proj__kpi cl-proj__kpi--green"><small>{{ s.kpi_total_label | replace: '[ans]', s.years | escape }}</small><strong data-out="total">—</strong></div>
          <div class="cl-proj__kpi"><small>{{ s.kpi_roi_label | escape }}</small><strong data-out="roi">—</strong></div>
        </div>

        <div>
          <div class="cl-bars" data-out="bars" aria-hidden="true"></div>
          <p class="cl-proj__legend">{{ s.legend | replace: '[prix]', s.reference_price | replace: '[ans]', s.years }}</p>
        </div>
      </clarte-projection>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clarté · Économies",
  "tag": "section",
  "class": "shopify-section--clarte-projection",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Projetez-vous" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Combien vous <em>économisez</em> vraiment ?</p>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Réglez votre facture actuelle : on estime vos économies année après année avec un kit solaire 6 panneaux posé. Une estimation prudente, affinée lors de votre appel technique.</p>" },
    { "type": "text", "id": "button_text", "label": "Bouton", "default": "Voir les kits solaires" },
    { "type": "url", "id": "button_url", "label": "Lien du bouton" },
    { "type": "header", "content": "Hypothèses du simulateur" },
    { "type": "range", "id": "saving_rate", "label": "Part de la facture économisée", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "inflation", "label": "Hausse annuelle de l'électricité", "min": 0, "max": 10, "step": 1, "unit": "%", "default": 4 },
    { "type": "number", "id": "reference_price", "label": "Prix posé de référence (€)", "default": 3300 },
    { "type": "range", "id": "years", "label": "Horizon (années)", "min": 10, "max": 30, "step": 5, "default": 20 },
    { "type": "header", "content": "Curseur" },
    { "type": "text", "id": "bill_label", "label": "Libellé", "default": "Ma facture d'électricité par mois" },
    { "type": "number", "id": "bill_min", "label": "Minimum (€)", "default": 50 },
    { "type": "number", "id": "bill_max", "label": "Maximum (€)", "default": 400 },
    { "type": "number", "id": "bill_default", "label": "Valeur par défaut (€)", "default": 150 },
    { "type": "header", "content": "Libellés" },
    { "type": "text", "id": "kpi_year_label", "label": "Économie annuelle", "default": "Économie la 1re année" },
    { "type": "text", "id": "kpi_total_label", "label": "Économie cumulée", "default": "Sur [ans] ans" },
    { "type": "text", "id": "kpi_roi_label", "label": "Retour sur investissement", "default": "Rentabilisé en" },
    { "type": "text", "id": "legend", "label": "Légende", "default": "Économies annuelles estimées sur [ans] ans, pour un kit posé à [prix] €. Barre ambre : première année." },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#0E1A2B" }
  ],
  "presets": [ { "name": "Clarté · Économies", "category": "Clarté" } ]
}
{% endschema %}
