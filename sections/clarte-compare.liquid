{%- comment -%}
  CLARTÉ — Comparatif « Clarté vs installateur classique vs kit internet »
  Colonnes fixes (3), lignes = blocs. Valeur : texte libre, ou « oui » / « non » pour afficher une coche / une croix.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #shopify-section-{{ section.id }} .cl-versus { background: {{ s.background | default: '#0E1A2B' }}; color: {{ s.text_color | default: '#F6F4EE' }}; }
</style>

<section class="cl-versus cl-section{% unless settings.clarte_heading_italic_accent %} cl-accent-color{% endunless %}" aria-labelledby="cl-versus-{{ section.id }}">
  <div class="cl-container">
    <div class="cl-head cl-head--center">
      {%- if s.eyebrow != blank -%}<p class="cl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="cl-versus-{{ section.id }}" class="cl-h2">{{ s.title | remove: '<p>' | remove: '</p>' }}</h2>
      {%- if s.text != blank -%}<div class="cl-lead">{{ s.text }}</div>{%- endif -%}
    </div>

    <div class="cl-versus__wrap">
      <table class="cl-versus__table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Critère</span></th>
            <th scope="col" class="cl-versus__us"><span class="cl-versus__brand">{{ s.col_1 | default: settings.clarte_company_name | escape }}</span>{%- if s.col_1_sub != blank -%}<span class="cl-versus__sub">{{ s.col_1_sub | escape }}</span>{%- endif -%}</th>
            <th scope="col"><span class="cl-versus__brand">{{ s.col_2 | escape }}</span>{%- if s.col_2_sub != blank -%}<span class="cl-versus__sub">{{ s.col_2_sub | escape }}</span>{%- endif -%}</th>
            <th scope="col"><span class="cl-versus__brand">{{ s.col_3 | escape }}</span>{%- if s.col_3_sub != blank -%}<span class="cl-versus__sub">{{ s.col_3_sub | escape }}</span>{%- endif -%}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              {%- for i in (1..3) -%}
                {%- assign key = 'value_' | append: i -%}
                {%- assign v = block.settings[key] | strip -%}
                {%- assign vd = v | downcase -%}
                <td{% if i == 1 %} class="cl-versus__us"{% endif %}>
                  {%- if vd == 'oui' -%}
                    <span class="cl-versus__yes">{%- render 'clarte-icon', icon: 'check' -%}<span class="sr-only">Oui</span></span>
                  {%- elsif vd == 'non' -%}
                    <span class="cl-versus__no">✕<span class="sr-only">Non</span></span>
                  {%- else -%}
                    {{ v | escape }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if s.button_text != blank -%}
      <div class="cl-actions cl-actions--center">
        {%- render 'button', content: s.button_text, href: s.button_url, size: 'xl' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Clarté · Comparatif",
  "tag": "section",
  "class": "shopify-section--clarte-compare",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Pourquoi acheter chez nous" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Le confort d’un installateur, <em>la clarté d’une boutique.</em></p>" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Ni devis à attendre, ni kit à monter soi-même : le prix posé est affiché, l’équipe certifiée fait le reste.</p>" },
    { "type": "header", "content": "Colonnes" },
    { "type": "text", "id": "col_1", "label": "Colonne 1 (vous)", "info": "Vide = nom de l’entreprise des réglages" },
    { "type": "text", "id": "col_1_sub", "label": "Sous-titre colonne 1", "default": "Prix posé en ligne" },
    { "type": "text", "id": "col_2", "label": "Colonne 2", "default": "Installateur classique" },
    { "type": "text", "id": "col_2_sub", "label": "Sous-titre colonne 2", "default": "Devis sur visite" },
    { "type": "text", "id": "col_3", "label": "Colonne 3", "default": "Kit acheté en ligne" },
    { "type": "text", "id": "col_3_sub", "label": "Sous-titre colonne 3", "default": "À poser soi-même" },
    { "type": "header", "content": "Bouton" },
    { "type": "text", "id": "button_text", "label": "Texte du bouton", "default": "Voir nos prix posés" },
    { "type": "url", "id": "button_url", "label": "Lien" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#0E1A2B" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#F6F4EE" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Prix connu avant tout engagement" },
        { "type": "text", "id": "value_1", "label": "Colonne 1", "default": "oui", "info": "« oui » = coche, « non » = croix, ou un texte libre" },
        { "type": "text", "id": "value_2", "label": "Colonne 2", "default": "non" },
        { "type": "text", "id": "value_3", "label": "Colonne 3", "default": "oui" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarté · Comparatif",
      "category": "Clarté",
      "blocks": [
        { "type": "row", "settings": { "label": "Prix posé connu avant tout engagement", "value_1": "oui", "value_2": "non", "value_3": "Matériel seul" } },
        { "type": "row", "settings": { "label": "Délai pour avoir un prix", "value_1": "Immédiat", "value_2": "2 à 6 semaines", "value_3": "Immédiat" } },
        { "type": "row", "settings": { "label": "Visite technique", "value_1": "Appel offert sous 48 h", "value_2": "Rendez-vous payant ou conditionné", "value_3": "non" } },
        { "type": "row", "settings": { "label": "Pose par installateur certifié RGE", "value_1": "oui", "value_2": "oui", "value_3": "non" } },
        { "type": "row", "settings": { "label": "Délai de pose", "value_1": "Sous 14 jours", "value_2": "1 à 3 mois", "value_3": "Vous-même" } },
        { "type": "row", "settings": { "label": "Démarches (mairie, Consuel, Enedis)", "value_1": "Incluses", "value_2": "Variable", "value_3": "non" } },
        { "type": "row", "settings": { "label": "Garantie décennale sur la pose", "value_1": "oui", "value_2": "oui", "value_3": "non" } },
        { "type": "row", "settings": { "label": "Paiement en ligne sécurisé, acompte 30 %", "value_1": "oui", "value_2": "non", "value_3": "100 % à la commande" } }
      ]
    }
  ]
}
{% endschema %}
