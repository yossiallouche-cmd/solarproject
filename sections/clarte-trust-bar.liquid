{%- comment -%}
  CLARTÉ — Bandeau de confiance (icône + titre + sous-texte), jusqu'à 5 éléments.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .cl-trust { background: {{ section.settings.background | default: '#FFFFFF' }}; color: {{ section.settings.text_color | default: '#0E1A2B' }}; }
</style>

{%- if section.blocks.size > 0 -%}
  <div class="cl-trust">
    <div class="cl-container">
      <ul class="cl-trust__list" role="list">
        {%- for block in section.blocks -%}
          <li class="cl-trust__item" {{ block.shopify_attributes }}>
            <span class="cl-trust__icon">{%- render 'clarte-icon', icon: block.settings.icon -%}</span>
            <div>
              <strong>{{ block.settings.title | escape }}</strong>
              <span>{{ block.settings.text | escape }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Clarté · Confiance",
  "tag": "section",
  "class": "shopify-section--clarte-trust",
  "disabled_on": { "groups": ["header", "custom.overlay"] },
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "background", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#0E1A2B" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "euro", "label": "Euro" }, { "value": "phone", "label": "Téléphone" }, { "value": "calendar", "label": "Calendrier" },
          { "value": "clock", "label": "Horloge" }, { "value": "shield", "label": "Bouclier" }, { "value": "check", "label": "Coche" },
          { "value": "bolt", "label": "Éclair" }, { "value": "tool", "label": "Outils" }, { "value": "truck", "label": "Camion" },
          { "value": "document", "label": "Document" }, { "value": "lock", "label": "Cadenas" }, { "value": "star", "label": "Étoile" } ], "default": "check" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Prix affichés, pose incluse" },
        { "type": "text", "id": "text", "label": "Sous-texte", "default": "Fourniture + pose, TTC, sans devis" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarté · Confiance",
      "category": "Clarté",
      "blocks": [
        { "type": "item", "settings": { "icon": "euro", "title": "Prix affichés, pose incluse", "text": "Fourniture + pose, TTC, sans devis" } },
        { "type": "item", "settings": { "icon": "phone", "title": "Appel technique offert", "text": "Sous 48 h, avec un technicien" } },
        { "type": "item", "settings": { "icon": "calendar", "title": "Posé sous 14 jours", "text": "Vérification et pose le même jour" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Garantie décennale", "text": "Installateurs certifiés RGE" } }
      ]
    }
  ]
}
{% endschema %}
