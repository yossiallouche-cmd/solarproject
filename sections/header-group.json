{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "m1": {
          "type": "message",
          "settings": {
            "text": "Le prix posé est affiché sur chaque page",
            "url": "/pages/comment-ca-marche"
          }
        },
        "m2": {
          "type": "message",
          "settings": {
            "text": "Besoin d’un conseil ou d’un devis ? Un conseiller vous répond",
            "url": "/pages/contact"
          }
        },
        "m3": {
          "type": "message",
          "settings": {
            "text": "Commandé aujourd’hui, posé sous 14 jours",
            "url": "/pages/comment-ca-marche"
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3"
      ],
      "settings": {
        "enable_sticky": false,
        "text_size": "text-xs",
        "navigation_mode": "arrows",
        "scrolling_speed": 10,
        "background": "#1e3ae6",
        "text_color": "#ffffff",
        "autoplay": true,
        "cycle_speed": 4
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "enable_sticky": true,
        "hide_on_scroll": false,
        "logo": "{{shop.brand.logo}}",
        "logo_max_width": 120,
        "logo_mobile_max_width": 100,
        "menu": "main-menu",
        "menu_open_trigger": "hover",
        "opening_from": "bottom",
        "layout": "logo_left_navigation_inline",
        "show_social_media": false,
        "show_country_flag": false,
        "show_country_name": false,
        "transparent_header_text_color": "#ffffff",
        "reduce_padding": false,
        "background_opacity": 100,
        "background_blur_radius": 0
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}