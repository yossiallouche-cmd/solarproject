{
  "type": "header",
  "name": "Header group",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "m1": {
          "type": "message",
          "settings": {
            "text": "Le prix posé est affiché sur chaque page",
            "url": "/pages/comment-ca-marche"
          }
        },
        "m2": {
          "type": "message",
          "settings": {
            "text": "Besoin d’un conseil ou d’un devis ? Un conseiller vous répond",
            "url": "/pages/contact"
          }
        },
        "m3": {
          "type": "message",
          "settings": {
            "text": "Commandé aujourd’hui, posé sous 14 jours",
            "url": "/pages/comment-ca-marche"
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3"
      ],
      "settings": {
        "enable_sticky": false,
        "show_on_homepage_only": false,
        "navigation_mode": "scrolling",
        "autoplay": true,
        "cycle_speed": 4,
        "scrolling_speed": 10,
        "text_size": "text-xs",
        "background": "#16181d",
        "background_gradient": "",
        "text_color": "#ffffff"
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "enable_sticky": true,
        "hide_on_scroll": false,
        "logo": "{{shop.brand.logo}}",
        "logo_max_width": 120,
        "logo_mobile_max_width": 100,
        "menu": "main-menu",
        "sidebar_menu": "",
        "secondary_menu": "",
        "customer_account_menu": "customer-account-main-menu",
        "menu_open_trigger": "hover",
        "opening_from": "bottom",
        "layout": "logo_left_navigation_inline",
        "show_social_media": false,
        "show_locale_selector": true,
        "show_country_selector": true,
        "show_country_flag": false,
        "show_country_name": false,
        "transparent_header_text_color": "#ffffff",
        "reduce_padding": false,
        "background_opacity": 100,
        "background_blur_radius": 0
      },
      "blocks": {
        "mm_solaire": {
          "type": "mega_menu",
          "settings": {
            "menu_item": "Solaire",
            "layout": "horizontal",
            "submenu_style": "bold_text",
            "image_1": "shopify://shop_images/clarte-hero-toiture-solaire.jpg",
            "image_heading_1": "Kits solaires posés",
            "image_link_1": "shopify://collections/panneaux-solaires",
            "image_text_color_1": "#ffffff",
            "image_2": "shopify://shop_images/pexels-photo-9800008.jpg",
            "image_heading_2": "Carports solaires",
            "image_link_2": "shopify://collections/carports-solaires",
            "image_text_color_2": "#ffffff"
          }
        },
        "mm_clim": {
          "type": "mega_menu",
          "settings": {
            "menu_item": "Chauffage & clim",
            "layout": "horizontal",
            "submenu_style": "bold_text",
            "image_1": "shopify://shop_images/pexels-photo-38067323.jpg",
            "image_heading_1": "Pompes à chaleur",
            "image_link_1": "shopify://collections/pompes-a-chaleur",
            "image_text_color_1": "#ffffff"
          }
        }
      },
      "block_order": [
        "mm_solaire",
        "mm_clim"
      ]
    },
    "reassurance": {
      "type": "barre-reassurance",
      "settings": {},
      "blocks": {
        "a": {
          "type": "item",
          "settings": {
            "icon": "picto-money",
            "text": "Prix posé affiché",
            "link": "/pages/comment-ca-marche"
          }
        },
        "b": {
          "type": "item",
          "settings": {
            "icon": "picto-phone",
            "text": "Appel technique offert sous 48 h",
            "link": "/pages/comment-ca-marche"
          }
        },
        "c": {
          "type": "item",
          "settings": {
            "icon": "picto-timer",
            "text": "Posé sous 14 jours",
            "link": "/pages/comment-ca-marche"
          }
        },
        "d": {
          "type": "item",
          "settings": {
            "icon": "picto-shield",
            "text": "Garantie décennale",
            "link": ""
          }
        },
        "e": {
          "type": "item",
          "settings": {
            "icon": "picto-operator",
            "text": "Conseiller et devis sur demande",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ]
    }
  },
  "order": [
    "announcement-bar",
    "header",
    "reassurance"
  ]
}