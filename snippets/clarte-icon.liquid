{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  CLARTÉ ICON
  ----------------------------------------------------------------------------------------------------------------------
  Petites icônes au trait utilisées par les sections Clarté.

  * icon : nom de l'icône (sun, car, battery, flame, snow, bolt, shield, phone, calendar, clock, euro, check, arrow,
           tool, leaf, home, star, truck, document, chat, lock, zap, umbrella)
  * class : classes CSS optionnelles
{%- endcomment -%}

{%- assign icon = icon | default: 'check' -%}
<svg class="{{ class }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'car' -%}
      <path d="M3 13l2-5a2 2 0 0 1 1.9-1.3h10.2A2 2 0 0 1 19 8l2 5v5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H6v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><circle cx="7.5" cy="14.5" r="1"/><circle cx="16.5" cy="14.5" r="1"/><path d="M2 8h2M20 8h2"/>
    {%- when 'carport' -%}
      <path d="M2 10l10-6 10 6"/><path d="M4 10v10M20 10v10"/><path d="M7 20v-3a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3"/><circle cx="9" cy="20" r="1"/><circle cx="15" cy="20" r="1"/><path d="M6 7.5h12M8 6.3v2.4M12 4v4M16 6.3v2.4"/>
    {%- when 'battery' -%}
      <rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 10v4"/><path d="M11 9.5l-2 3h3l-2 3"/>
    {%- when 'flame' -%}
      <path d="M12 22c4 0 7-2.7 7-6.5 0-3-2-5-3.5-7.5-.5 2-1.5 3-2.5 3.5 0-3-1.5-6-4-8.5-.5 3.5-4 5.5-4 11C5 19.3 8 22 12 22z"/>
    {%- when 'snow' -%}
      <path d="M12 2v20M4 6l16 12M20 6L4 18"/><path d="M9 4l3 2 3-2M9 20l3-2 3 2M3.5 9.5l3.5.5 1-3.4M20.5 14.5l-3.5-.5-1 3.4M3.5 14.5l3.5-.5 1 3.4M20.5 9.5l-3.5.5-1-3.4"/>
    {%- when 'bolt' or 'zap' -%}
      <path d="M13 2L4 14h7l-1 8 9-12h-7z"/>
    {%- when 'shield' -%}
      <path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'phone' -%}
      <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15h3v3H8z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'euro' -%}
      <path d="M18 6.5A7 7 0 0 0 7 9M18 17.5A7 7 0 0 1 7 15"/><path d="M4 11h11M4 14h10"/>
    {%- when 'check' -%}
      <path d="M5 12l4 4L19 6"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'tool' -%}
      <path d="M14.5 6.5a4 4 0 0 0 5 5L10 21l-3 .5.5-3z"/><path d="M14 6l4 4"/><path d="M3 7l4-4 3 3-4 4z"/>
    {%- when 'leaf' -%}
      <path d="M4 20C4 10 10 4 21 3c-1 11-7 17-17 17z"/><path d="M4 20c3-5 7-9 12-12"/>
    {%- when 'home' -%}
      <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>
    {%- when 'star' -%}
      <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/>
    {%- when 'document' -%}
      <path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'umbrella' -%}
      <path d="M3 13a9 9 0 0 1 18 0z"/><path d="M12 13v6a2 2 0 0 0 4 0M12 4V2"/>
    {%- when 'gauge' -%}
      <path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15l4-5"/><circle cx="12" cy="15" r="1.2"/>
    {%- else -%}
      <path d="M5 12l4 4L19 6"/>
  {%- endcase -%}
</svg>
