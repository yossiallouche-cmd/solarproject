{%- comment -%}
  Bloc prix posé (fiche produit)
  Prix lus via le snippet clarte-variant-prices (métachamps de variante ou grille produit custom.grille_pose).

  * product, product_form_id, block
{%- endcomment -%}

{%- liquid
  assign b = block.settings
  assign variant = product.selected_or_first_available_variant
  capture vp
    render 'clarte-variant-prices', product: product, variant: variant
  endcapture
  assign vp = vp | split: '|'
  assign fourniture = vp[0] | plus: 0
  assign pose = vp[1] | plus: 0
  assign total = variant.price
  assign call_hours = settings.clarte_call_hours | default: 48
-%}

<clarte-pricebox class="cl-pricebox" form="{{ product_form_id }}" data-variant="{{ variant.id }}">
  <script type="application/json" data-variants>
    {
      {%- for v in product.variants -%}
        {%- capture vpv -%}{%- render 'clarte-variant-prices', product: product, variant: v -%}{%- endcapture -%}
        {%- assign vpv = vpv | split: '|' -%}
        "{{ v.id }}": { "f": {{ vpv[0] | plus: 0 }}, "p": {{ vpv[1] | plus: 0 }}, "t": {{ v.price }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

  <div class="cl-pricebox__head">
    <strong>{{ b.title | escape }}</strong>
    {%- if b.badge != blank -%}<span class="cl-chip cl-chip--amber">{{ b.badge | escape }}</span>{%- endif -%}
  </div>

  {%- if fourniture > 0 or pose > 0 -%}
    <div class="cl-price-line"><span>{{ b.label_fourniture | escape }}</span><span class="cl-amount" data-out="fourniture">{{ fourniture | money_without_trailing_zeros }}</span></div>
    <div class="cl-price-line"><span>{{ b.label_pose | escape }}</span><span class="cl-amount" data-out="pose">{{ pose | money_without_trailing_zeros }}</span></div>
  {%- endif -%}
  {%- if b.show_call_line -%}
    <div class="cl-price-line"><span>{{ b.label_call | replace: '[appel]', call_hours | escape }}</span><span class="cl-free">{{ b.label_free | escape }}</span></div>
  {%- endif -%}
  <div data-extras></div>
  <div class="cl-price-line cl-price-line--total"><span>{{ b.label_total | escape }}</span><span class="cl-amount" data-out="total">{{ total | money_without_trailing_zeros }}</span></div>

  <p class="cl-pricebox__note">
    {%- if cart.taxes_included -%}{{ 'product.general.taxes_included' | t }}{%- else -%}{{ 'product.general.taxes_excluded' | t }}{%- endif %}
  </p>
</clarte-pricebox>
