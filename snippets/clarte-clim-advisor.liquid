{%- comment -%}
  Conseil climatisation (fiche produit)
  Questions enchaînées automatiquement (nombre de pièces, surface), puis sélection de la variante conseillée.

  * product, product_form_id, block
{%- endcomment -%}

{%- assign b = block.settings -%}

<clarte-clim-advisor
  id="clim-advisor-{{ section.id }}"
  class="cl-advisor"
  form="{{ product_form_id }}"
  data-watts-per-m2="{{ b.watts_per_m2 }}"
  data-surfaces="{{ b.surfaces | escape }}"
  data-q-rooms="{{ b.q_rooms | escape }}"
  data-q-surface="{{ b.q_surface | escape }}"
  data-more-text="{{ b.more_text | escape }}"
  data-note="{{ b.note | escape }}"
>
  <script type="application/json" data-product>
    {
      "options": [
        {%- for option in product.options_with_values -%}
          { "name": {{ option.name | json }}, "values": {{ option.values | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "variants": [
        {%- for v in product.variants -%}
          { "id": {{ v.id }}, "options": {{ v.options | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  {%- if b.title != blank -%}<p class="h6">{{ b.title | escape }}</p>{%- endif -%}
  <div class="cl-advisor__steps" data-steps></div>
  <div class="cl-advisor__result" data-result aria-live="polite" hidden></div>
</clarte-clim-advisor>
