{%- comment -%}
  CLARTÉ — Configurateur visuel (fiche produit)
  Remplace le sélecteur de variantes : chaque option numérique (ex. « 3,5 m ») devient un curseur, les autres
  deviennent des cartes. Un aperçu SVG (vue de dessus) et un récapitulatif (panneaux, kWc, surface) se mettent à
  jour en direct. La sélection pilote le sélecteur de variantes d'Impact, qui reste présent mais masqué.

  Prix lus dans le métachamp produit custom.prix_pose (JSON par SKU : f, p, n, kwc) ou, s'ils existent, dans les métachamps de variante.

  * product, product_form_id, block
{%- endcomment -%}

{%- assign b = block.settings -%}
{%- assign grid = product.metafields.custom.prix_pose.value -%}

<style>
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="variant-picker"] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<clarte-configurator class="cl-config" form="{{ product_form_id }}" data-preview="{{ b.show_preview }}">
  <script type="application/json" data-product>
    {
      "options": [
        {%- for option in product.options_with_values -%}
          { "name": {{ option.name | json }}, "position": {{ option.position }}, "values": {{ option.values | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "variants": [
        {%- for v in product.variants -%}
          {%- assign gv = grid[v.sku] -%}
          { "id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "available": {{ v.available }},
            "f": {{ v.metafields.custom.fourniture.value | default: gv.f | default: 0 | times: 100 | round }},
            "p": {{ v.metafields.custom.pose.value | default: gv.p | default: 0 | times: 100 | round }},
            "panels": {{ v.metafields.custom.panneaux.value | default: gv.n | default: 0 }},
            "kwc": {{ v.metafields.custom.kwc.value | default: gv.kwc | default: 0 }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "selected": {{ product.selected_or_first_available_variant.options | json }}
    }
  </script>

  {%- if b.title != blank -%}<p class="cl-config__title">{{ b.title | escape }}</p>{%- endif -%}

  {%- if b.show_preview -%}
    <div class="cl-config__preview" data-preview-box>
      <svg viewBox="0 0 400 260" data-svg aria-hidden="true"></svg>
      <div class="cl-config__facts" data-facts></div>
    </div>
  {%- endif -%}

  <div class="cl-config__options" data-options></div>

  {%- if b.note != blank -%}<p class="cl-config__note">{{ b.note }}</p>{%- endif -%}
</clarte-configurator>
